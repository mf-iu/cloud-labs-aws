// Dev container for the AWS labs of the cloud computing course.
// Open this folder from WSL in VS Code and choose "Reopen in Container".
// The first start builds the image and takes several minutes.
{
  "name": "Cloud-Kurs: AWS",
  "build": { "dockerfile": "Dockerfile" },

  // The parent folder is mounted, so that PlaceFinder and the other
  // repositories next to this one are available in the container, too.
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    // Own Docker Engine inside the container (Docker in Docker)
    "ghcr.io/devcontainers/features/docker-in-docker:4": { "moby": false },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },

  // SSH keys and the AWS login stay in WSL and survive a rebuild of the container
  "initializeCommand": "mkdir -p \"$HOME/.ssh\" \"$HOME/.aws\"",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind",
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind"
  ],

  "remoteUser": "vscode",
  "containerEnv": {
    "COURSE_PROVIDER": "aws",
    // The uv cache and the projects are on different file systems
    "UV_LINK_MODE": "copy"
  },
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "PlaceFinder" } },

  // Shows the versions of all tools; run it again at any time
  "postCreateCommand": "tools/check-tools.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "opentofu.vscode-opentofu",
        // The AWS Toolkit of the aws-cli feature is not needed for the labs
        "-AmazonWebServices.aws-toolkit-vscode"
      ]
    }
  }
}
